# BeatWave environment template
# Copy to .env locally or configure as deployment secrets.
# Never commit real secrets.

APP_ENV=development
APP_NAME=BeatWave
APP_PUBLIC_URL=https://your-mini-app-domain.example
API_PUBLIC_URL=https://your-api-domain.example
LOG_LEVEL=INFO

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
MINI_APP_SHORT_NAME=beatwave

# Authentication/session
APP_SESSION_SECRET=replace-with-a-long-random-secret
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# Database
DATABASE_URL=postgresql+asyncpg://beatwave:change-me@postgres:5432/beatwave

# Redis
REDIS_URL=redis://redis:6379/0

# Security / frontend
CORS_ALLOWED_ORIGINS=https://your-mini-app-domain.example
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Provider selection
MUSIC_PROVIDER=demo
MUSIC_PROVIDER_API_KEY=
MUSIC_PROVIDER_CLIENT_ID=
MUSIC_PROVIDER_CLIENT_SECRET=

# Audio delivery / storage (only if authorized and required)
AUDIO_STORAGE_ENDPOINT=
AUDIO_STORAGE_BUCKET=
AUDIO_STORAGE_ACCESS_KEY=
AUDIO_STORAGE_SECRET_KEY=
AUDIO_CDN_BASE_URL=

# Rate limits
REQUESTS_PER_USER_PER_WINDOW=5
REQUEST_RATE_LIMIT_WINDOW_SECONDS=300

# Observability
SENTRY_DSN=
METRICS_ENABLED=false
